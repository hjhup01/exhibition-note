# 같은 창 구글 로그인(Streamlit 내장 st.login) 설정 예시.
# 이 PC: 이 파일을 .streamlit/secrets.toml 로 복사해 값을 채운다(secrets.toml은 git에 올리지 않는다).
# Streamlit Cloud: 앱 Settings → Secrets 에 아래 내용을 그대로 붙여 넣고 redirect_uri만 배포 주소로 바꾼다.
# 구글 콘솔(클라이언트 → 승인된 리디렉션 URI)에 redirect_uri 값을 똑같이 추가해야 한다(끝이 /oauth2callback).

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"   # 배포: "https://<앱주소>.streamlit.app/oauth2callback"
cookie_secret = "임의의-긴-문자열"                        # 아무 무작위 문자열(32자 이상 권장)
client_id = "구글 OAuth 클라이언트 ID"
client_secret = "구글 OAuth 클라이언트 보안 비밀번호"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = "access"                                 # 시트 읽기·쓰기에 access token이 필요하다

[auth.client_kwargs]
scope = "openid email https://www.googleapis.com/auth/drive.file"
