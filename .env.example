# 이 파일을 .env로 복사해 값을 채운다. 배포할 때는 같은 이름으로 Streamlit Secrets에 넣는다.

# 공공데이터포털 '한국문화정보원_한눈에보는문화정보조회서비스'
CULTURE_API_KEY=

# 카카오 디벨로퍼스 REST API 키
KAKAO_REST_API_KEY=

# AWS Bedrock (요약)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# BEDROCK_MODEL_ID=   # 비우면 기본 Claude 모델

# LangSmith 트레이싱
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# 구글 로그인 + 사용자별 드라이브 시트 저장
# 권장: .streamlit/secrets.toml 에 [auth]를 넣으면 같은 창 로그인(st.login)을 쓰고 아래 값은 쓰지 않는다
#       (예시: .streamlit/secrets.toml.example).
# [auth]도 없고 두 값도 비우면 이 PC의 SQLite(data/exhibitions.db)에 저장한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 로컬 실행: http://localhost:8501 / 배포: https://<앱이름>.streamlit.app (구글 콘솔의 '승인된 리디렉션 URI'와 똑같이)
GOOGLE_REDIRECT_URI=http://localhost:8501
